# Study area: "Greater Banjul" (decided 14 Nov 2026, see README "Study area")
# = Banjul City Council (GM01: GM0101-GM0103)
# + Kanifing Municipal Council (GM05: GM0501-GM0506)
# + Kombo North/St Marie district (GM0308)
# Codes are OCHA COD-AB admin-2 p-codes (gmb_admin2, valid_on 2022-09-01).
STUDY_ADM2 := GM0101,GM0102,GM0103,GM0501,GM0502,GM0503,GM0504,GM0505,GM0506,GM0308

# Roads and facilities are loaded for the study area plus this buffer (metres), to avoid edge effects.
BUFFER_M := 5000

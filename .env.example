# Copy to .env to override the defaults. Everything works without a .env file.
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis
# Host port for connecting QGIS/psql to the database (5433 avoids clashing with a local PostgreSQL)
DB_PORT=5433

# User/group id the ETL container runs as (so ./data stays owned by you). Check with: id -u / id -g
HOST_UID=1000
HOST_GID=1000

# Host port for the API (http://localhost:8000/docs)
API_PORT=8000
